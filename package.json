{
  "name": "sistema-sumaq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:cobranzas": "ts-node --compiler-options \"{\\\"module\\\":\\\"commonjs\\\"}\" prisma/seed-cobranzas.ts",
    "test:unit": "jest --config jest.unit.config.cjs",
    "test:coverage": "jest --config jest.unit.config.cjs --coverage",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:api": "newman run postman/cobranzas-api.postman_collection.json",
    "test:perf": "docker run --rm -i -v \"${PWD}:/app\" -w /app grafana/k6 run tests/perf/cuotas-load.js -e BASE_URL=http://host.docker.internal:3000"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "react": "19.2.3",
    "react-big-calendar": "^1.19.4",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.7",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.32",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^30.5.2",
    "newman": "^6.2.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
