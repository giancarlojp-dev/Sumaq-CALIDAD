// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String @id @default(uuid())
  nombre       String
  email        String @unique
  rol          String
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientesAtendidos Cliente[]
  pagosRegistrados  Pago[]
}

model Inventario {
  id              String   @id @default(uuid())
  nombre          String
  categoria       String
  stockActual     Int
  ubicacion       String
  puntoReorden    Int
  capacidadMaxima Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movimientos     Movimiento[]
  alertas         Alerta[]
  recomendaciones Recomendacion[]
  qaRegistros     QaRegistro[]
}

model Movimiento {
  id             String   @id @default(uuid())
  idItem         String
  fecha          DateTime @default(now())
  tipoMovimiento String
  cantidad       Int

  inventario     Inventario @relation(fields: [idItem], references: [id], onDelete: Cascade)
}

model Proyecto {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  fechaInicio DateTime
  fechaFin    DateTime?
  estado      String

  qaRegistros QaRegistro[]
}

model QaRegistro {
  id          String   @id @default(uuid())
  idItem      String
  idProyecto  String
  fecha       DateTime @default(now())
  estadoQa    String
  observacion String?

  inventario  Inventario @relation(fields: [idItem], references: [id], onDelete: Cascade)
  proyecto    Proyecto   @relation(fields: [idProyecto], references: [id], onDelete: Cascade)
}

model Alerta {
  id          String   @id @default(uuid())
  idItem      String
  fecha       DateTime @default(now())
  nivelAlerta String
  mensaje     String

  inventario  Inventario @relation(fields: [idItem], references: [id], onDelete: Cascade)
}

model Recomendacion {
  id                String   @id @default(uuid())
  idItem            String
  fecha             DateTime @default(now())
  ubicacionSugerida String

  inventario        Inventario @relation(fields: [idItem], references: [id], onDelete: Cascade)
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

enum EstadoComprobante {
  EMITIDO
}

model Cliente {
  id            String    @id @default(uuid())
  nombre        String    @db.VarChar(120)
  documento     String    @unique @db.VarChar(20)
  email         String?   @db.VarChar(120)
  telefono      String?   @db.VarChar(30)
  proyecto      String    @db.VarChar(150)
  responsableId String?
  creadoEn      DateTime  @default(now())

  responsable   Usuario?  @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  cuotas        Cuota[]

  @@index([responsableId])
}

model Cuota {
  id               String    @id @default(uuid())
  clienteId        String
  numero           Int
  concepto         String    @db.VarChar(150)
  monto            Decimal   @db.Decimal(12, 2)
  fechaVencimiento DateTime  @db.Date
  creadoEn         DateTime  @default(now())

  cliente          Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pagos            Pago[]

  @@unique([clienteId, numero])
  @@index([clienteId])
  @@index([fechaVencimiento])
}

model Pago {
  id             String      @id @default(uuid())
  cuotaId        String
  monto          Decimal     @db.Decimal(12, 2)
  montoMora      Decimal     @db.Decimal(12, 2)
  montoCapital   Decimal     @db.Decimal(12, 2)
  metodo         MetodoPago
  referencia     String?     @db.VarChar(60)
  idempotencyKey String?     @unique @db.VarChar(100)
  registradoPorId String
  fechaPago      DateTime    @default(now())
  creadoEn       DateTime    @default(now())

  cuota          Cuota       @relation(fields: [cuotaId], references: [id], onDelete: Cascade)
  registradoPor  Usuario     @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)
  comprobante    Comprobante?

  @@index([cuotaId])
  @@index([registradoPorId])
}

model Comprobante {
  id           String             @id @default(uuid())
  pagoId       String             @unique
  serie        String             @db.VarChar(10)
  numero       Int
  montoTotal   Decimal            @db.Decimal(12, 2)
  emitidoEn    DateTime           @default(now())
  emitidoPorId String
  estado       EstadoComprobante  @default(EMITIDO)

  pago         Pago               @relation(fields: [pagoId], references: [id], onDelete: Restrict)

  @@unique([serie, numero])
  @@index([pagoId])
}

model SerieComprobante {
  serie        String @id @db.VarChar(10)
  ultimoNumero Int    @default(0)
}
